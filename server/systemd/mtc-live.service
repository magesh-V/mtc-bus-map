[Unit]
Description=MTC live buses: Chennai One route-by-route poll -> mapsv2/live/vehicles.json + GPS archive
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/mtc-live
EnvironmentFile=%h/projects/mtc-live/session.env
ExecStart=/usr/bin/python3 live_collector.py --stops %h/projects/maps-site/mapsv2/data/route_stops.json --timings %h/projects/maps-site/mapsv2/data/timings.json --stop-dist %h/projects/maps-site/mapsv2/data/stop_dist.json --archive %h/projects/mtc-live/archive --out %h/projects/maps-site/mapsv2/live/vehicles.json --rate 4
Restart=always
RestartSec=30
Nice=5
StandardOutput=append:%h/projects/mtc-live/logs/live.log
StandardError=append:%h/projects/mtc-live/logs/live.log

[Install]
WantedBy=default.target
